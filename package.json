{
  "name": "on-the-spot",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "On the Spot — local learning and recall",
  "main": "electron/main.mjs",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run test && npm run build",
    "package": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "jose": "^6.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "typescript": "^5.9.0",
    "vite": "8.3.1"
  },
  "author": "On the Spot",
  "build": {
    "appId": "com.onthespot.desktop",
    "productName": "On the Spot",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "README.md",
      "THIRD-PARTY-NOTICES.txt"
    ],
    "extraResources": [
      {
        "from": "voice-runtime",
        "to": "voice-runtime",
        "filter": [
          "ggml-base.bin",
          "Release/whisper-cli.exe",
          "Release/whisper.dll",
          "Release/ggml*.dll"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
